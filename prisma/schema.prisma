datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               Int      @id @default(autoincrement())
  firebaseUid      String   @unique
  email            String   @unique
  name             String?
  photoURL         String?
  role             String   @default("USER") // USER or ADMIN
  referralCode     String   @unique
  referredById     Int?
  referredBy       User?    @relation("ReferralTree", fields: [referredById], references: [id])
  referrals        User[]   @relation("ReferralTree")
  planId           Int?
  plan             Plan?    @relation(fields: [planId], references: [id])
  walletBalance    Decimal  @default(0.0)
  isBlocked        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  milestones       Milestone[]
  purchases        Purchase[]
  transactions     Transaction[]
  withdrawalRequests WithdrawalRequest[]
  poolEntries      AutoPoolEntry[]
  paymentIntents   PaymentIntent[]
  ottSubscriptions OttSubscription[]
}

model OttSubscription {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  platform    String   // e.g., Netflix, Prime, Disney+
  username    String?
  password    String?
  link        String?
  status      String   @default("PENDING") // PENDING, ACTIVE, EXPIRED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Plan {
  id               Int      @id @default(autoincrement())
  name             String
  price            Decimal
  levelCount       Int
  levelPercentages String   // JSON string
  users            User[]
  purchases        Purchase[]
}

model AutoPool {
  id          Int             @id @default(autoincrement())
  name        String          // Pool 1, Pool 2, Pool 3
  entryFee    Decimal
  matrixWidth Int             @default(3)
  matrixDepth Int             @default(3)
  reward      Decimal
  entries     AutoPoolEntry[]
}

model AutoPoolEntry {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  pool        AutoPool  @relation(fields: [poolId], references: [id])
  poolId      Int
  parentId    Int?
  parent      AutoPoolEntry? @relation("PoolTree", fields: [parentId], references: [id])
  children    AutoPoolEntry[] @relation("PoolTree")
  level       Int       @default(1)
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model Purchase {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  plan      Plan     @relation(fields: [planId], references: [id])
  planId    Int
  createdAt DateTime @default(now())
}

model Transaction {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  amount      Decimal
  type        String   // CREDIT or DEBIT
  category    String   // DIRECT_INCOME, POOL_INCOME, WITHDRAWAL, RE_ENTRY
  description String?
  txHash      String?  @unique // For on-chain cross-referencing
  createdAt   DateTime @default(now())
}

model PaymentIntent {
  id              String   @id @default(cuid())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  amount          Decimal  // e.g. 600
  token           String   @default("USDT")
  network         String   @default("BSC")
  status          String   @default("INITIATED") // INITIATED, PENDING, VERIFIED, FAILED
  txHash          String?  @unique
  confirmations   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WithdrawalRequest {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  amount      Decimal
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  processedAt DateTime?
}

model Milestone {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  slab        Int      // 10, 20, 50
  amount      Decimal
  createdAt   DateTime @default(now())
  
  @@unique([userId, slab])
}

model AppConfig {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String // JSON or raw value
}
