generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  firebaseUid        String              @unique
  email              String              @unique
  name               String?
  photoURL           String?
  role               String              @default("USER")
  referralCode       String              @unique
  referredById       Int?
  planId             Int?
  walletBalance      Decimal             @default(0.0)
  isBlocked          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  poolEntries        AutoPoolEntry[]
  milestones         Milestone[]
  ottSubscriptions   OttSubscription[]
  paymentIntents     PaymentIntent[]
  purchases          Purchase[]
  transactions       Transaction[]
  plan               Plan?               @relation(fields: [planId], references: [id])
  referredBy         User?               @relation("ReferralTree", fields: [referredById], references: [id])
  referrals          User[]              @relation("ReferralTree")
  withdrawalRequests WithdrawalRequest[]
}

model OttSubscription {
  id              Int            @id @default(autoincrement())
  userId          Int
  paymentIntentId String?        @unique
  platform        String
  username        String?
  password        String?
  link            String?
  status          String         @default("PENDING")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id])
  user            User           @relation(fields: [userId], references: [id])
}

model Plan {
  id               Int        @id @default(autoincrement())
  name             String
  price            Decimal
  levelCount       Int
  levelPercentages String
  purchases        Purchase[]
  users            User[]
}

model AutoPool {
  id          Int             @id @default(autoincrement())
  name        String
  entryFee    Decimal
  matrixWidth Int             @default(3)
  matrixDepth Int             @default(3)
  reward      Decimal
  entries     AutoPoolEntry[]
}

model AutoPoolEntry {
  id            Int             @id @default(autoincrement())
  userId        Int
  poolId        Int
  parentId      Int?
  level         Int             @default(1)
  isCompleted   Boolean         @default(false)
  upgradeChoice String?
  createdAt     DateTime        @default(now())
  completedAt   DateTime?
  parent        AutoPoolEntry?  @relation("PoolTree", fields: [parentId], references: [id])
  children      AutoPoolEntry[] @relation("PoolTree")
  pool          AutoPool        @relation(fields: [poolId], references: [id])
  user          User            @relation(fields: [userId], references: [id])
}

model Purchase {
  id        Int      @id @default(autoincrement())
  userId    Int
  planId    Int
  createdAt DateTime @default(now())
  plan      Plan     @relation(fields: [planId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  amount      Decimal
  type        String
  category    String
  description String?
  txHash      String?  @unique
  metadata    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model PaymentIntent {
  id            String   @id @default(cuid())
  userId        Int
  amount        Decimal
  token         String   @default("USDT")
  network       String   @default("BSC")
  status        String   @default("INITIATED")
  txHash        String?  @unique
  confirmations Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id])
  ottSubscription OttSubscription?
}

model WithdrawalRequest {
  id              Int       @id @default(autoincrement())
  userId          Int
  amount          Decimal
  walletAddress   String
  status          String    @default("PENDING")
  txHash          String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  processedAt     DateTime?
  user            User      @relation(fields: [userId], references: [id])
}

model Milestone {
  id        Int      @id @default(autoincrement())
  userId    Int
  slab      Int
  amount    Decimal
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, slab])
}

model AppConfig {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}
